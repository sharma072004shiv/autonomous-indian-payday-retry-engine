# ============================================================
# Autonomous Indian PayDay & Mandate Retry Engine
# Environment Variable Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
# Options: development | production | test

APP_DEBUG=true
# Set to false in production

APP_LOG_LEVEL=INFO
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Database ─────────────────────────────────────────────────
DATABASE_PATH=./data/payday_engine.db
# Relative or absolute path to the SQLite database file.
# The directory will be created automatically if it does not exist.

# ── LLM / PydanticAI ─────────────────────────────────────────
LLM_PROVIDER=openai
# The LLM provider used by PydanticAI.
# Options: openai | anthropic | gemini | groq
# In test mode this value is ignored; mock classifier is used instead.

OPENAI_API_KEY=sk-replace-me
# Required when LLM_PROVIDER=openai.
# Never commit a real key.

ANTHROPIC_API_KEY=replace-me
# Required when LLM_PROVIDER=anthropic.

GEMINI_API_KEY=replace-me
# Required when LLM_PROVIDER=gemini.

LLM_MODEL=gpt-4o-mini
# The specific model name passed to PydanticAI.

LLM_TIMEOUT_SECONDS=10
# Maximum seconds to wait for an LLM classification response.
# If exceeded, the policy engine falls back to HARD_DECLINE.

LLM_USE_MOCK=false
# Set to true to skip real LLM calls and use the deterministic
# mock classifier. Always true during automated tests.

# ── Retry Policy ─────────────────────────────────────────────
POLICY_MAX_RETRIES=3
# Hard cap on retries per transaction. Cannot be overridden by LLM.

POLICY_MIN_AMOUNT_PAISE=10000
# Minimum transaction amount in paise (100 paise = ₹1).
# Default 10000 paise = ₹100. Transactions below this are never retried.

# ── Scheduler ────────────────────────────────────────────────
SCHEDULER_POLL_INTERVAL_SECONDS=60
# How often the retry scheduler polls for due retries.

SCHEDULER_ENABLED=true
# Set to false to disable the background scheduler (e.g. during tests).

# ── Mock Razorpay Executor ───────────────────────────────────
MOCK_EXECUTOR_SUCCESS_RATE=0.72
# Simulated success rate (0.0 – 1.0) for mock payment attempts.
# Used by the benchmark runner and integration tests.
# This is NOT a real Razorpay configuration value.

MOCK_EXECUTOR_SEED=42
# Random seed for the mock executor to ensure deterministic test results.
